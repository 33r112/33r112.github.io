---
import InnerLayout from "../layouts/InnerLayout.astro";

const placeholderReview =
  "Full review placeholder — replace with the real write-up when it's ready. This is where a longer breakdown goes: what worked, what didn't, and why it's still worth remembering months later, instead of just the one-line summary above.";

const items = [
  { title: "Persona 5 Royal", year: 2020, category: "game", tags: ["PS5", "JRPG"], rating: "9.0" },
  { title: "Hollow Knight", year: 2017, category: "game", tags: ["PC", "Metroidvania"], rating: "9.5" },
  { title: "Baldur's Gate 3", year: 2023, category: "game", tags: ["PC", "RPG"], rating: "9.0" },
  { title: "Celeste", year: 2018, category: "game", tags: ["Switch", "Platformer"], rating: "9.0" },
  { title: "Get Out", year: 2017, category: "movie-tv", tags: ["Movie", "Horror"], rating: "8.0" },
  { title: "Severance", year: 2022, category: "movie-tv", tags: ["TV", "Sci-Fi"], rating: "9.0" },
  { title: "Parasite", year: 2019, category: "movie-tv", tags: ["Movie", "Thriller"], rating: "9.0" },
  { title: "The Bear", year: 2022, category: "movie-tv", tags: ["TV", "Drama"], rating: "8.5" },
  { title: "Invincible", year: 2003, category: "anime-manga", tags: ["Manga"], rating: "8.0" },
  { title: "Frieren: Beyond Journey's End", year: 2023, category: "anime-manga", tags: ["Anime"], rating: "9.0" },
  { title: "Chainsaw Man", year: 2018, category: "anime-manga", tags: ["Manga", "Vol. 12"], rating: "8.5" },
  { title: "Vinland Saga", year: 2019, category: "anime-manga", tags: ["Anime"], rating: "9.0" },
  { title: "Berserk", year: 1989, category: "anime-manga", tags: ["Manga"], rating: "9.5" },
].map((item, i) => ({ ...item, id: `library-review-${i}` }));
---

<InnerLayout
  current="library"
  title="Library — THREAD 33"
  description="Games, movies, TV, anime and manga — everything logged in THREAD 33's library."
>
  <h1 class="page-title">Library</h1>

  <div>
    <div class="filter-tabs" data-filter-group="#library-list" role="tablist" aria-label="Filter by category">
      <button type="button" class="filter-tab is-active" data-filter="all">All</button>
      <button type="button" class="filter-tab" data-filter="game">Games</button>
      <button type="button" class="filter-tab" data-filter="movie-tv">Movies &amp; TV</button>
      <button type="button" class="filter-tab" data-filter="anime-manga">Anime &amp; Manga</button>
    </div>

    <div class="library-list" id="library-list">
      {items.map((item) => (
        <div class="library-item" data-category={item.category}>
          <a
            class="library-row bracket-hover"
            role="button"
            tabindex="0"
            aria-expanded="false"
            data-notes-toggle={item.id}
          >
            <div class="cover-placeholder" data-label="COVER"></div>
            <div class="library-row__info">
              <div class="library-row__head">
                <span class="library-title">{item.title}</span>
                <span class="library-year">{item.year}</span>
              </div>
              <div class="library-tags">
                {item.tags.map((tag) => <span class="project-tag">{tag}</span>)}
                <span class="project-tag">{item.rating}</span>
              </div>
            </div>
          </a>
          <div class="library-expand" id={item.id} hidden>
            <div class="article-body">
              <p>{placeholderReview}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</InnerLayout>

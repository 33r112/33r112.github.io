      <label>
        模糊
        <input type="number" autocomplete="off" data-frost-lib-blur min="0" max="60" step="1" value="0" />
        <input type="range" autocomplete="off" data-frost-lib-blur-slider min="0" max="60" step="1" value="0" />
      </label>
      <label>
        亮度
        <input type="number" autocomplete="off" data-frost-lib-brightness min="0" max="300" step="1" value="100" />
        <input type="range" autocomplete="off" data-frost-lib-brightness-slider min="0" max="300" step="1" value="100" />
      </label>
      <label>
        对比度
        <input type="number" autocomplete="off" data-frost-lib-contrast min="0" max="300" step="1" value="100" />
        <input type="range" autocomplete="off" data-frost-lib-contrast-slider min="0" max="300" step="1" value="100" />
      </label>
      <label>
        饱和度
        <input type="number" autocomplete="off" data-frost-lib-saturate min="0" max="300" step="1" value="5" />
        <input type="range" autocomplete="off" data-frost-lib-saturate-slider min="0" max="300" step="1" value="5" />
      </label>
    </div>
  </div>

  <!-- master show/hide for the panel below, same button Writing uses.
       Starts open. Remove along with the panel itself. -->
  <button type="button" class="fx-test-toggle" id="fx-test-toggle" data-fx-test-toggle>
    收起测试按钮
  </button>

  <div class="page-header">
    <h1 class="page-title"><img src="/img/headers/reviews.png" alt="Reviews" /></h1>
    <StatsGroup items={categoryFilters} filterTarget="#library-list" filterAttr="category" defaultFilter="game" />
  </div>

  <div class="library-list" id="library-list">
    {items.map((item) => (
      <div class="library-item" data-category={item.category}>
        <a
          class="library-row bracket-hover"
          role="button"
          tabindex="0"
          aria-expanded="false"
          data-notes-toggle={item.id}
        >
          <div class="cover-placeholder" data-label="COVER"></div>
          <div class="library-row__info">
            <div class="library-row__head">
              <span class="library-title">{item.title}</span>
              <span class="library-year">{item.year}</span>
            </div>
            <div class="library-tags">
              {item.tags.map((tag) => <span class="project-tag">{tag}</span>)}
              <span class="project-tag">{item.rating}</span>
            </div>
          </div>
        </a>
        <div class="library-expand" id={item.id} hidden>
          <div class="article-body">
            <p>{placeholderReview}</p>
          </div>
        </div>
      </div>
      ))}
    </div>
</InnerLayout>

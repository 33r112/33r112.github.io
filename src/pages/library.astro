---
import InnerLayout from "../layouts/InnerLayout.astro";
import StatsGroup from "../components/StatsGroup.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { formatDate } from "../utils/formatDate";
import placeholderCover from "../assets/library-placeholder-cover.png";

// Games are real write-ups now, one file each under content/reviews/games.
// Anime/Manga is starting to fill in the same way, under
// content/reviews/anime-manga — it and Movies/TV (still the original
// placeholders) share a single "Other" filter tab, so the card below
// renders whichever shape it's handed regardless of which of the two
// an item actually is.
const reviewEntries = await getCollection("reviews");
const rendered = await Promise.all(
  reviewEntries
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry, i) => {
      const { Content } = await render(entry);
      return {
        kind: "review",
        id: `library-game-${i}`,
        category: "game",
        Content,
        ...entry.data,
      };
    })
);

const animeMangaEntries = await getCollection("animeManga");
const renderedAnimeManga = await Promise.all(
  animeMangaEntries
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry, i) => {
      const { Content } = await render(entry);
      return {
        kind: "media",
        id: `library-media-${i}`,
        category: "other",
        Content,
        ...entry.data,
      };
    })
);

const placeholderReview =
  "Full review placeholder — replace with the real write-up when it's ready. This is where a longer breakdown goes: what worked, what didn't, and why it's still worth remembering months later, instead of just the one-line summary above.";

// the count tag's unit depends on the medium — a manga's issue count is
// "chapters", a Western comic's is "issues"; anything else (or once
// TV/anime need a season+episode pair instead of one of these) isn't
// covered here yet.
const issueUnit = "话";

const placeholders = [
  { title: "Severance", year: 2022, category: "other", tags: ["TV", "Sci-Fi"], rating: "9.0", dateAdded: "2026-04-27" },
  { title: "Parasite", year: 2019, category: "other", tags: ["Movie", "Thriller"], rating: "9.0", dateAdded: "2026-05-14" },
  { title: "The Bear", year: 2022, category: "other", tags: ["TV", "Drama"], rating: "8.5", dateAdded: "2026-06-02" },
  { title: "Chainsaw Man", year: 2018, category: "other", tags: ["Manga", "Vol. 12"], rating: "8.5", dateAdded: "2026-07-25" },
  { title: "Vinland Saga", year: 2019, category: "other", tags: ["Anime"], rating: "9.0", dateAdded: "2026-08-11" },
  { title: "Berserk", year: 1989, category: "other", tags: ["Manga"], rating: "9.5", dateAdded: "2026-08-24" },
].map((item, i) => ({ ...item, kind: "placeholder", id: `library-review-${i}` }));

const items = [...rendered, ...renderedAnimeManga, ...placeholders];

const latest = items.reduce((newest, item) => {
  const d = item.date ?? new Date(`${item.dateAdded}T00:00:00Z`);
  return d > newest ? d : newest;
}, new Date(0));

const categoryCounts = items.reduce((counts, item) => {
  counts[item.category] = (counts[item.category] || 0) + 1;
  return counts;
}, {});

const categoryFilters = [
  { text: `Games(${categoryCounts.game ?? 0})`, filter: "game" },
  { text: `Other(${categoryCounts.other ?? 0})`, filter: "other" },
];
const libraryStats = { latest: formatDate(latest) };

// Other has its own grid + accordion layout (see .library-grid below),
// so it's a completely separate list from Games' rows rather than one
// shared list filtered by category.
const gameItems = items.filter((item) => item.category === "game");
const otherItems = items.filter((item) => item.category === "other");
const GRID_COLUMNS = 4;

---

<InnerLayout
  current="library"
  title="Library — THREAD 33"
  description="Games, movies, TV, anime and manga — everything logged in THREAD 33's library."
  sidebarStats={libraryStats}
>




  <!-- temporary: preset sizes for Other's expanded detail panel title.
       Remove along with the toggle button once a size is picked. -->
  <div class="hue-test fx-test sleep-anim-test" id="sleep-anim-test-panel">
    <div class="fx-test__group">
      <span class="fx-test__label">展开面板标题字号</span>
      <button type="button" data-grid-title-size="1.25rem">1.25rem</button>
      <button type="button" data-grid-title-size="1.5rem">1.5rem</button>
      <button type="button" data-grid-title-size="1.75rem">1.75rem</button>
      <button type="button" data-grid-title-size="2rem">2rem</button>
      <button type="button" data-grid-title-size="2.25rem">2.25rem</button>
    </div>
  </div>

  <!-- master show/hide for the panel below, same button Writing uses.
       Starts collapsed. Remove along with the panel itself. -->
  <button type="button" class="fx-test-toggle" id="fx-test-toggle" data-fx-test-toggle>
    展开测试按钮
  </button>

  <div class="page-header">
    <h1 class="page-title"><img src="/img/headers/reviews.png" alt="Reviews" /></h1>
    <StatsGroup items={categoryFilters} filterTarget="#library-list" filterAttr="category" defaultFilter="game" showAll={false} />
  </div>

  <div class="library-list" id="library-list">
    {gameItems.map((item) => (
      <div class="library-item" data-category={item.category}>
        <a
          class="library-row bracket-hover"
          role="button"
          tabindex="0"
          aria-expanded="false"
          data-notes-toggle={item.id}
        >
          <div class="library-cover-wrap">
            <Image class="library-cover" src={item.cover} alt="" height={200} densities={[1, 2]} />
            {item.status === "白金" && (
              <img class="library-platinum" src="/img/baijin.png" alt="白金" title="白金" />
            )}
          </div>
          <div class="library-row__info">
            <div class="library-row__head">
              <span class="library-title">{item.title}</span>
              {item.year && <span class="library-year">{item.year}</span>}
              {item.liked && <span class="library-heart" title="喜欢">♥</span>}
            </div>
            <div class="library-tags">
              <span class="project-tag library-tag--hours">{item.hours}h</span>
              {item.platform && <span class="project-tag">{item.platform}</span>}
            </div>
          </div>
          <span class="library-played">{formatDate(item.date)}</span>
        </a>
        <div class="library-expand" id={item.id} hidden>
          <div class="article-body">
            <item.Content />
          </div>
          <button type="button" class="notes-collapse" data-notes-collapse aria-label="收起">&gt;&gt;</button>
        </div>
      </div>
      ))}
    </div>

    <!-- Other: a 4-column grid instead of a row list — each card shows
         only its cover + title, and clicking one opens a full-width
         detail panel right under whichever row of 4 it belongs to,
         with a small arrow pointing back up at the card that opened
         it. One shared "slot" per row of GRID_COLUMNS cards carries
         whichever card's detail was most recently opened, cloned in
         from that card's own template; see initLibraryGrid(). -->
    <div class="library-grid" id="library-grid" hidden>
      {otherItems.map((item, i) => (
        <>
          <button
            type="button"
            class="library-grid-card"
            data-grid-card={item.id}
            aria-expanded="false"
          >
            <Image
              class="library-grid-cover"
              src={item.kind === "media" ? item.cover : placeholderCover}
              alt=""
              height={200}
              densities={[1, 2]}
            />
            <span class="library-grid-title">{item.kind === "media" ? (item.titleZh || item.title) : item.title}</span>
          </button>
          <template data-grid-detail={item.id}>
            <div class="library-grid-meta">
              <div class="library-grid-meta__head">
                <span class="library-grid-meta__title">{item.title}</span>
                {item.kind === "media" && (
                  <span class="library-grid-meta__date">{formatDate(item.date)}</span>
                )}
              </div>
              {item.kind === "media" ? (
                <span>
                  {[item.author, `全${item.issue}${issueUnit}`, item.year].filter(Boolean).join(" / ")}
                </span>
              ) : (
                <span>
                  {[...item.tags, item.rating].filter(Boolean).join(" / ")}
                </span>
              )}
            </div>
            <hr class="library-grid-divider" />
            <div class="article-body">
              {item.kind === "media" ? <item.Content /> : <p>{placeholderReview}</p>}
            </div>
          </template>
          {(i % GRID_COLUMNS === GRID_COLUMNS - 1 || i === otherItems.length - 1) && (
            <div class="library-grid-slot" hidden>
              <span class="library-grid-arrow" aria-hidden="true"></span>
              <div class="library-grid-slot-content"></div>
              <button type="button" class="notes-collapse" data-grid-collapse aria-label="收起">&gt;&gt;</button>
            </div>
          )}
        </>
      ))}
    </div>
</InnerLayout>

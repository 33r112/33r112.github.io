---
import InnerLayout from "../layouts/InnerLayout.astro";
---

<InnerLayout current="about" title="About — THREAD 33" description="About ryoku33r and what THREAD 33 is.">
  <h1 class="page-title">About</h1>

  <section class="about-section" aria-labelledby="about-me-heading">
    <h2 id="about-me-heading" class="section-heading">About Me</h2>
    <p class="about-text">
      I'm ryoku33r — I make things, mostly games and the occasional tool,
      and I keep a running record of what I play, watch and read. This
      site is where that record lives.
    </p>
  </section>

  <section class="about-section" aria-labelledby="interests-heading">
    <h2 id="interests-heading" class="section-heading">Interests</h2>
    <p class="about-text">
      RPGs — turn-based and otherwise — game design and systems, Unreal
      Engine, old web culture, and whatever anime or manga I've most
      recently gotten attached to.
    </p>
  </section>

  <section class="about-section" aria-labelledby="what-is-heading">
    <h2 id="what-is-heading" class="section-heading">What THREAD 33 Is</h2>
    <p class="about-text">
      THREAD 33 is a personal archive, not a portfolio and not a blog.
      Library keeps track of games, movies, TV, anime and manga I've gone
      through. Projects holds things I've built. Notes is where ideas
      worth keeping — mostly about game design and development — get
      written down instead of lost. It's meant to be added to for a long
      time, not launched once and abandoned.
    </p>
  </section>

  <section class="about-section" aria-labelledby="links-heading">
    <h2 id="links-heading" class="section-heading">Links</h2>
    <div class="links-list">
      <a href="#">GitHub</a>
    </div>
  </section>
</InnerLayout>

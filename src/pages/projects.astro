---
import InnerLayout from "../layouts/InnerLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { formatDate } from "../utils/formatDate";

const entries = await getCollection("projects");

const latestDate = entries.reduce(
  (latest, entry) => (entry.data.date > latest ? entry.data.date : latest),
  entries[0].data.date
);
const projectsStats = {
  latest: formatDate(latestDate),
};

const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const id = `project-modal-${entry.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
    const dateDisplay = formatDate(entry.data.date);
    return { entry, Content, id, dateDisplay };
  })
);
---

<InnerLayout
  current="projects"
  title="Projects — THREAD 33"
  description="Things ryoku33r has built — starting with a turn-based × action RPG in Unreal Engine 5."
  sidebarStats={projectsStats}
>
  <!-- temporary: width presets for CBZRebinder's cover thumbnail and
       inline screenshot. Remove this panel (and go back to a plain
       fixed width) once sizes are picked. -->
  <div class="size-test" id="project-size-test">
    <div class="size-test__group">
      <span class="size-test__label">封面宽度</span>
      <button type="button" data-project-cover-w="60px">60px</button>
      <button type="button" data-project-cover-w="80px">80px</button>
      <button type="button" data-project-cover-w="100px">100px</button>
      <button type="button" data-project-cover-w="120px">120px</button>
      <button type="button" data-project-cover-w="160px">160px</button>
    </div>
    <div class="size-test__group">
      <span class="size-test__label">截图宽度</span>
      <button type="button" data-project-shot-w="50%">50%</button>
      <button type="button" data-project-shot-w="60%">60%</button>
      <button type="button" data-project-shot-w="75%">75%</button>
      <button type="button" data-project-shot-w="90%">90%</button>
      <button type="button" data-project-shot-w="100%">100%</button>
    </div>
    <div class="size-test__group">
      <span class="size-test__label">截图亮度</span>
      <button type="button" data-project-shot-brightness="100%">100%</button>
      <button type="button" data-project-shot-brightness="90%">90%</button>
      <button type="button" data-project-shot-brightness="80%">80%</button>
      <button type="button" data-project-shot-brightness="70%">70%</button>
      <button type="button" data-project-shot-brightness="60%">60%</button>
    </div>
  </div>

  <div class="page-header">
    <h1 class="page-title"><img src="/img/headers/projects.png" alt="Projects" /></h1>
  </div>

  <div class="projects-list" id="projects-list">
    {rendered.map(({ entry, Content, id, dateDisplay }) => (
      <div class="project-item">
        <a class="project-row bracket-hover" role="button" tabindex="0" data-project-open={id}>
          {entry.data.cover ? (
            <Image class="project-screenshot" src={entry.data.cover} alt="" width={320} densities={[1, 2]} />
          ) : (
            <div class="project-screenshot" data-label="SCREENSHOT"></div>
          )}
          <div class="project-row__info">
            <span class="project-row__title">{entry.data.title}</span>
            <p class="project-row__desc">{entry.data.summary}</p>
          </div>
        </a>

        <dialog class="project-modal" id={id} aria-labelledby={`${id}-heading`} tabindex="-1">
          <span class="project-modal__date">{dateDisplay}</span>
          <h2 id={`${id}-heading`} class="project-title">{entry.data.title}</h2>
          <div class="project-tags">
            {entry.data.tags.map((tag) => <span class="project-tag">{tag}</span>)}
          </div>
          <div class="article-body">
            <Content />
          </div>
        </dialog>
      </div>
    ))}
  </div>
</InnerLayout>

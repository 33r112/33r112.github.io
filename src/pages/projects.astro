---
import InnerLayout from "../layouts/InnerLayout.astro";
---

<InnerLayout
  current="projects"
  title="Projects — THREAD 33"
  description="Things ryoku33r has built — starting with a turn-based × action RPG in Unreal Engine 5."
>
  <h1 class="page-title">Projects</h1>

  <section class="block-project" aria-labelledby="project-1-heading">
    <div class="project-block">
      <div class="project-screenshot" data-label="SCREENSHOT"></div>
      <div>
        <h2 id="project-1-heading" class="project-title">Untitled RPG Project</h2>
        <div class="project-tags">
          <span class="project-tag">Unreal Engine 5</span>
          <span class="project-tag">Turn-Based × Action RPG</span>
          <span class="project-tag">In Development</span>
        </div>
        <p class="project-desc">
          A turn-based × action combat RPG built in Unreal Engine 5. Combat
          blends real-time positioning with a turn-based skill system —
          currently prototyping the skill-slot design and encounter flow.
        </p>
        <p class="project-desc">
          This is the first entry here. Screenshots, a proper name and a
          devlog will replace this placeholder as the project moves past
          early prototyping — see <a href="/notes">Notes</a> for
          development log entries in the meantime.
        </p>
      </div>
    </div>
  </section>
</InnerLayout>

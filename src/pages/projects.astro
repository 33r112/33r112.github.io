---
import InnerLayout from "../layouts/InnerLayout.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "../utils/formatDate";

const entries = await getCollection("projects");

const latestDate = entries.reduce(
  (latest, entry) => (entry.data.date > latest ? entry.data.date : latest),
  entries[0].data.date
);
const projectsStats = {
  latest: formatDate(latestDate),
};

const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const id = `project-modal-${entry.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
    const dateDisplay = formatDate(entry.data.date);
    return { entry, Content, id, dateDisplay };
  })
);
---

<InnerLayout
  current="projects"
  title="Projects — THREAD 33"
  description="Things ryoku33r has built — starting with a turn-based × action RPG in Unreal Engine 5."
  sidebarStats={projectsStats}
>
  <!-- temporary: size/position sliders for the header wordmark image,
       remove along with the matching CSS/JS once values are picked -->
  <button type="button" class="page-title-img-test-toggle" data-title-img-test-toggle>Show Test Controls</button>
  <div class="hue-test page-title-img-test" id="page-title-img-test-panel" hidden>
    <label>
      Height
      <input type="number" data-title-img-height min="20" max="300" step="1" value="150" />px
      <input type="range" data-title-img-height-slider min="20" max="300" step="1" value="150" />
    </label>
    <label>
      X
      <input type="number" data-title-img-x min="-100" max="100" step="1" value="0" />px
      <input type="range" data-title-img-x-slider min="-100" max="100" step="1" value="0" />
    </label>
    <label>
      Y
      <input type="number" data-title-img-y min="-100" max="100" step="1" value="0" />px
      <input type="range" data-title-img-y-slider min="-100" max="100" step="1" value="0" />
    </label>
  </div>

  <h1 class="page-title"><img src="/img/headers/projects.png" alt="Projects" /></h1>

  <div class="projects-list" id="projects-list">
    {rendered.map(({ entry, Content, id, dateDisplay }) => (
      <div class="project-item">
        <a class="project-row bracket-hover" role="button" tabindex="0" data-project-open={id}>
          <div class="project-screenshot" data-label="SCREENSHOT"></div>
          <div class="project-row__info">
            <span class="project-row__title">{entry.data.title}</span>
            <p class="project-row__desc">{entry.data.summary}</p>
          </div>
        </a>

        <dialog class="project-modal" id={id} aria-labelledby={`${id}-heading`} tabindex="-1">
          <span class="project-modal__date">{dateDisplay}</span>
          <h2 id={`${id}-heading`} class="project-title">{entry.data.title}</h2>
          <div class="project-tags">
            {entry.data.tags.map((tag) => <span class="project-tag">{tag}</span>)}
          </div>
          <div class="article-body">
            <Content />
          </div>
        </dialog>
      </div>
    ))}
  </div>
</InnerLayout>

        透明度
        <input type="number" autocomplete="off" data-panel-shadow-a min="0" max="100" step="1" value="100" />
        <input type="range" autocomplete="off" data-panel-shadow-a-slider min="0" max="100" step="1" value="100" />
      </label>
      <label>
        横向偏移
        <input type="number" autocomplete="off" data-panel-shadow-x min="-100" max="100" step="1" value="0" />
        <input type="range" autocomplete="off" data-panel-shadow-x-slider min="-100" max="100" step="1" value="0" />
      </label>
      <label>
        纵向偏移
        <input type="number" autocomplete="off" data-panel-shadow-y min="-100" max="100" step="1" value="-100" />
        <input type="range" autocomplete="off" data-panel-shadow-y-slider min="-100" max="100" step="1" value="-100" />
      </label>
      <label>
        模糊
        <input type="number" autocomplete="off" data-panel-shadow-blur min="0" max="120" step="1" value="60" />
        <input type="range" autocomplete="off" data-panel-shadow-blur-slider min="0" max="120" step="1" value="60" />
      </label>
      <label>
        扩散
        <input type="number" autocomplete="off" data-panel-shadow-spread min="0" max="60" step="1" value="0" />
        <input type="range" autocomplete="off" data-panel-shadow-spread-slider min="0" max="60" step="1" value="0" />
      </label>
    </div>
  </div>

  <!-- temporary: scale/position/speed sliders for the sidebar pixel
       sprite — its own panel on the left, since it's the one thing being
       tuned against the sidebar rather than the content panel. Remove
       along with the matching CSS/JS once values are picked. -->
  <div class="hue-test fx-test sleep-anim-test" id="sleep-anim-test-panel">
    <div class="fx-test__group">
      <span class="fx-test__label">标题图片</span>
      <label>
        高度
        <input type="number" autocomplete="off" data-page-title-h min="20" max="400" step="1" value="150" />
        <input type="range" autocomplete="off" data-page-title-h-slider min="20" max="400" step="1" value="150" />
      </label>
      <label>
        横向偏移
        <input type="number" autocomplete="off" data-page-title-x min="-300" max="300" step="1" value="0" />
        <input type="range" autocomplete="off" data-page-title-x-slider min="-300" max="300" step="1" value="0" />
      </label>
      <label>
        纵向偏移
        <input type="number" autocomplete="off" data-page-title-y min="-300" max="300" step="1" value="0" />
        <input type="range" autocomplete="off" data-page-title-y-slider min="-300" max="300" step="1" value="0" />
      </label>
    </div>
    <div class="fx-test__group">
      <span class="fx-test__label">导航栏动画</span>
      <label>
        放大倍数
        <input type="number" autocomplete="off" data-sleep-scale min="1" max="12" step="1" value="2" />
        <input type="range" autocomplete="off" data-sleep-scale-slider min="1" max="12" step="1" value="2" />
      </label>
      <label>
        横向偏移
        <input type="number" autocomplete="off" data-sleep-x min="-300" max="300" step="1" value="150" />
        <input type="range" autocomplete="off" data-sleep-x-slider min="-300" max="300" step="1" value="150" />
      </label>
      <label>
        纵向偏移
        <input type="number" autocomplete="off" data-sleep-y min="-300" max="300" step="1" value="-40" />
        <input type="range" autocomplete="off" data-sleep-y-slider min="-300" max="300" step="1" value="-40" />
      </label>
      <label>
        播放间隔
        <input type="number" autocomplete="off" data-sleep-speed min="50" max="3000" step="50" value="2000" />
        <input type="range" autocomplete="off" data-sleep-speed-slider min="50" max="3000" step="50" value="2000" />
      </label>
      <label>
        黑白
        <input type="number" autocomplete="off" data-sleep-grayscale min="0" max="100" step="1" value="0" />
        <input type="range" autocomplete="off" data-sleep-grayscale-slider min="0" max="100" step="1" value="0" />
      </label>
      <label>
        亮度
        <input type="number" autocomplete="off" data-sleep-brightness min="0" max="300" step="1" value="80" />
        <input type="range" autocomplete="off" data-sleep-brightness-slider min="0" max="300" step="1" value="80" />
      </label>
      <label>
        对比度
        <input type="number" autocomplete="off" data-sleep-contrast min="0" max="300" step="1" value="100" />
        <input type="range" autocomplete="off" data-sleep-contrast-slider min="0" max="300" step="1" value="100" />
      </label>
      <label>
        饱和度
        <input type="number" autocomplete="off" data-sleep-saturate min="0" max="300" step="1" value="100" />
        <input type="range" autocomplete="off" data-sleep-saturate-slider min="0" max="300" step="1" value="100" />
      </label>
      <label>
        色相
        <input type="number" autocomplete="off" data-sleep-hue min="0" max="360" step="1" value="0" />
        <input type="range" autocomplete="off" data-sleep-hue-slider min="0" max="360" step="1" value="0" />
      </label>
      <label>
        复古
        <input type="number" autocomplete="off" data-sleep-sepia min="0" max="100" step="1" value="0" />
        <input type="range" autocomplete="off" data-sleep-sepia-slider min="0" max="100" step="1" value="0" />
      </label>
      <label>
        透明度
        <input type="number" autocomplete="off" data-sleep-a min="0" max="100" step="1" value="80" />
        <input type="range" autocomplete="off" data-sleep-a-slider min="0" max="100" step="1" value="80" />
      </label>
    </div>
  </div>

  <div class="page-header page-header--quadrant">
    <h1 class="page-title"><img src="/img/headers/writing.png" alt="Writing" /></h1>
    <StatsGroup items={writingCounts} filterTarget="#notes-list" filterAttr="kind" defaultFilter="article" />
  </div>

  <div class="notes-list" id="notes-list">
    {rendered.map(({ kind, entry, Content, expandId, dateDisplay, dateAttr }) =>
      kind === "micro" ? (
        <div class="notes-micro-item" data-kind={kind} data-date={dateAttr}>
          <div class="notes-micro-main">
            <span class="notes-micro-date">{dateDisplay}</span>
            <div class="notes-micro-body article-body">
              <Content />
            </div>
          </div>
          {entry.data.avatar && (
            <div class="notes-micro-thumb">
              <img src={entry.data.avatar} alt="" />
            </div>
          )}
        </div>
      ) : (
        <div class="notes-item" data-kind={kind}>
          <a
            class="notes-row bracket-hover"
            role="button"
            tabindex="0"
            aria-expanded="false"
            data-notes-toggle={expandId}
            data-category={entry.data.category}
            data-date={dateAttr}
          >
            <div class="notes-row__body">
              <div class="notes-row__head">
                <span class="notes-title">{entry.data.title}</span>
                <span class="notes-date">{dateDisplay}</span>
              </div>
              <p class="notes-row__desc">{entry.data.description}</p>
            </div>
            <div class="notes-row__thumb">
              <img src={entry.data.avatar} alt="" />
            </div>
          </a>
          <div class="notes-expand" id={expandId} hidden>
            <div class="article-body">
              <Content />
            </div>
            <button type="button" class="notes-collapse" data-notes-collapse aria-label="收起">&gt;&gt;</button>
          </div>
        </div>
      )
    )}
  </div>
</InnerLayout>

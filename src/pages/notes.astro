---
import InnerLayout from "../layouts/InnerLayout.astro";
import StatsGroup from "../components/StatsGroup.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "../utils/formatDate";

const noteEntries = await getCollection("posts");
const microEntries = await getCollection("thoughts");

const combined = [
  ...noteEntries.map((entry) => ({ kind: "article" as const, entry })),
  ...microEntries.map((entry) => ({ kind: "micro" as const, entry })),
];
combined.sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());

const writingCounts = [
  { text: `Posts(${noteEntries.length})`, filter: "article" },
  { text: `Thoughts(${microEntries.length})`, filter: "micro" },
];

const writingStats = {
  latest: formatDate(combined[0].entry.data.date),
};

const rendered = await Promise.all(
  combined.map(async ({ kind, entry }) => {
    const { Content } = await render(entry);
    const slug = entry.id.replace(/[^a-zA-Z0-9_-]/g, "-");
    const expandId = `notes-expand-${slug}`;
    const d = entry.data.date;
    const dateDisplay = formatDate(d);
    const dateAttr = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(
      d.getUTCDate()
    ).padStart(2, "0")}`;
    return { kind, entry, Content, expandId, dateDisplay, dateAttr };
  })
);

---
import InnerLayout from "../layouts/InnerLayout.astro";
import StatsGroup from "../components/StatsGroup.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "../utils/formatDate";

const noteEntries = await getCollection("posts");
const microEntries = await getCollection("thoughts");

const combined = [
  ...noteEntries.map((entry) => ({ kind: "article" as const, entry })),
  ...microEntries.map((entry) => ({ kind: "micro" as const, entry })),
];
combined.sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());

const writingCounts = [
  { text: `Posts(${noteEntries.length})`, filter: "article" },
  { text: `Thoughts(${microEntries.length})`, filter: "micro" },
];

const writingStats = {
  latest: formatDate(combined[0].entry.data.date),
};

const rendered = await Promise.all(
  combined.map(async ({ kind, entry }) => {
    const { Content } = await render(entry);
    const slug = entry.id.replace(/[^a-zA-Z0-9_-]/g, "-");
    const expandId = `notes-expand-${slug}`;
    const d = entry.data.date;
    const dateDisplay = formatDate(d);
    const dateAttr = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(
      d.getUTCDate()
    ).padStart(2, "0")}`;
    return { kind, entry, Content, expandId, dateDisplay, dateAttr };
  })
);
---

<InnerLayout
  current="notes"
  title="Notes — THREAD 33"
  description="Game design, development and media notes worth keeping around."
  sidebarStats={writingStats}
>
  <div class="page-header">
    <h1 class="page-title"><img src="/img/headers/writing.png" alt="Writing" /></h1>
    <StatsGroup items={writingCounts} filterTarget="#notes-list" filterAttr="kind" defaultFilter="article" />
  </div>

  <div class="notes-list" id="notes-list">
    {rendered.map(({ kind, entry, Content, expandId, dateDisplay, dateAttr }) =>
      kind === "micro" ? (
        <div class="notes-micro-item" data-kind={kind} data-date={dateAttr}>
          <div class="notes-micro-main">
            <span class="notes-micro-date">{dateDisplay}</span>
            <div class="notes-micro-body article-body">
              <Content />
            </div>
          </div>
          {entry.data.avatar && (
            <div class="notes-micro-thumb">
              <img src={entry.data.avatar} alt="" />
            </div>
          )}
        </div>
      ) : (
        <div class="notes-item" data-kind={kind}>
          <a
            class="notes-row bracket-hover"
            role="button"
            tabindex="0"
            aria-expanded="false"
            data-notes-toggle={expandId}
            data-category={entry.data.category}
            data-date={dateAttr}
          >
            <div class="notes-row__body">
              <div class="notes-row__head">
                <span class="notes-title">{entry.data.title}</span>
                <span class="notes-date">{dateDisplay}</span>
              </div>
              <p class="notes-row__desc">{entry.data.description}</p>
            </div>
            <div class="notes-row__thumb">
              <img src={entry.data.avatar} alt="" />
            </div>
          </a>
          <div class="notes-expand" id={expandId} hidden>
            <div class="article-body">
              <Content />
            </div>
            <button type="button" class="notes-collapse" data-notes-collapse aria-label="收起">&gt;&gt;</button>
          </div>
        </div>
      )
    )}
  </div>
</InnerLayout>

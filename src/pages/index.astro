---
import Layout from "../layouts/Layout.astro";
import NavVertical from "../components/NavVertical.astro";
---

<Layout title="THREAD 33" description="THREAD 33 is a personal archive for media, projects and notes.">
  <div class="home-frame">
    <div class="home-frame__bg" aria-hidden="true"></div>

    <!-- temporary: background color presets, remove once a value is picked -->
    <div class="hue-test">
      <button type="button" data-color-preset="none">Original</button>
      <button type="button" data-color-preset="blue">Blue</button>
      <button type="button" data-color-preset="yellow">Yellow</button>
      <button type="button" data-color-preset="red">Red</button>
      <button type="button" data-color-preset="white">White</button>
    </div>

    <!-- temporary: background scale presets, remove once a value is picked -->
    <div class="hue-test scale-test">
      <button type="button" data-size-preset="auto">Auto</button>
      <button type="button" data-size-preset="25">25%</button>
      <button type="button" data-size-preset="50">50%</button>
      <button type="button" data-size-preset="100">100%</button>
      <button type="button" data-size-preset="200">200%</button>
      <button type="button" data-size-preset="300">300%</button>
      <button type="button" data-size-preset="500">500%</button>
      <button type="button" data-size-preset="1000">1000%</button>
    </div>

    <!-- temporary: background image toggle, remove once a choice is made -->
    <div class="hue-test image-test">
      <button type="button" data-bg-image="stars">Starfield</button>
      <button type="button" data-bg-image="bricks">Bricks</button>
      <button type="button" data-bg-image="vgrid">Vgrid</button>
    </div>

    <!-- temporary: filter + size sliders, remove once values are picked.
         Clicking a preset button above updates these to match, and the
         number boxes are editable — typing a value also updates the
         matching slider. -->
    <div class="hue-test filter-sliders">
      <label>
        Hue
        <input type="number" data-filter-number="hue-rotate" min="0" max="360" step="1" value="120" />°
        <input type="range" data-filter-slider="hue-rotate" data-unit="deg" min="0" max="360" step="1" value="120" />
      </label>
      <label>
        Gray
        <input type="number" data-filter-number="grayscale" min="0" max="100" step="1" value="0" />%
        <input type="range" data-filter-slider="grayscale" data-unit="%" min="0" max="100" step="1" value="0" />
      </label>
      <label>
        Sat
        <input type="number" data-filter-number="saturate" min="0" max="200" step="1" value="100" />%
        <input type="range" data-filter-slider="saturate" data-unit="%" min="0" max="200" step="1" value="100" />
      </label>
      <label>
        Bright
        <input type="number" data-filter-number="brightness" min="0" max="200" step="1" value="100" />%
        <input type="range" data-filter-slider="brightness" data-unit="%" min="0" max="200" step="1" value="100" />
      </label>
      <label>
        Size
        <input type="number" data-size-number min="0" max="1000" step="1" value="200" />%
        <input type="range" data-size-slider min="0" max="1000" step="1" value="200" />
      </label>
    </div>

    <div class="home-wrap">
      <div class="home-window-columns">
        <aside class="home-left" aria-label="Navigation">
          <div class="placeholder-fill home-portrait-placeholder" data-label="PORTRAIT"></div>

          <NavVertical current="home" />

          <div class="placeholder-fill home-info-placeholder" data-label="INFO"></div>
        </aside>

        <div class="home-main">
          <div class="placeholder-fill home-banner-placeholder" data-label="BANNER"></div>

          <section class="home-welcome" aria-labelledby="welcome-heading">
            <h1 id="welcome-heading" class="home-block__heading">Welcome</h1>
            <p class="home-welcome__lead">
              This is THREAD 33 —
              ryoku33r's personal archive. I'm slowly moving my stuff off
              social media and into this corner instead: the games, movies
              and anime I go through, the things I build, notes before I
              forget them. Have a look around.
            </p>
          </section>

          <div class="placeholder-fill home-links-placeholder" data-label="LINKS"></div>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import NavVertical from "../components/NavVertical.astro";
---

<Layout title="THREAD 33" description="THREAD 33 is a personal archive for media, projects and notes.">
  <div class="home-frame">
    <div class="home-frame__bg" aria-hidden="true"></div>

    <div class="home-wrap">
      <div class="home-window-columns">
        <aside class="home-left" aria-label="Navigation">
          <div class="placeholder-fill home-portrait-placeholder" data-label="PORTRAIT"></div>

          <NavVertical current="home" />

          <div class="placeholder-fill home-info-placeholder" data-label="INFO"></div>
        </aside>

        <div class="home-main">
          <div class="placeholder-fill home-banner-placeholder" data-label="BANNER"></div>

          <section class="home-welcome" aria-labelledby="welcome-heading">
            <h1 id="welcome-heading" class="home-block__heading">Welcome</h1>
            <p class="home-welcome__lead">
              This is THREAD 33 —
              ryoku33r's personal archive. I'm slowly moving my stuff off
              social media and into this corner instead: the games, movies
              and anime I go through, the things I build, notes before I
              forget them. Have a look around.
            </p>
          </section>

          <div class="placeholder-fill home-links-placeholder" data-label="LINKS"></div>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from "./Layout.astro";
import NavVertical from "../components/NavVertical.astro";
import SidebarStats from "../components/SidebarStats.astro";

export interface Props {
  current: "library" | "projects" | "notes" | "about";
  title: string;
  description: string;
  sidebarStats?: {
    latest: string;
  };
}

const { current, title, description, sidebarStats } = Astro.props;
---

<Layout title={title} description={description}>
  <!-- the decorative sky banner + character art are NOT rendered here.
       Astro's ClientRouter replaces <body> wholesale on every navigation
       (only re-attaching transition:persist elements that also have a
       matching one in the *new* page's template), and that reparenting
       was itself causing a visible repaint on these large fixed
       background layers even with transitions disabled. They're instead
       injected once, outside <body> entirely, by
       initPersistentBackground() in main.js — see base.css for the
       matching stacking-context notes. -->

  <main class="container shell notes-shell" class:list={[current === "notes" && "shell--quadrant"]} id="main-content">
    <aside class="sidebar-col" class:list={[current !== "about" && "sidebar-col--titled"]} aria-label="Navigation">
      <div class="sleep-anim" aria-hidden="true">
        <div class="sleep-anim__sprite"></div>
      </div>
      {current === "notes" && <div class="quadrant-divider--h-left" aria-hidden="true"></div>}
      <NavVertical current={current} />
      {sidebarStats && <SidebarStats {...sidebarStats} />}
    </aside>

    {current === "notes" && (
      <>
        <div class="quadrant-divider--v" aria-hidden="true"></div>
        <div class="quadrant-divider--h" aria-hidden="true"></div>
        <div class="fx-layer fx-layer--frost" aria-hidden="true"></div>
        <div class="fx-layer fx-layer--vignette" aria-hidden="true"></div>
        <div class="fx-layer fx-layer--noise" aria-hidden="true"></div>
        <div class="fx-layer fx-layer--scanlines" aria-hidden="true"></div>
        <div class="fx-layer fx-layer--gradient" aria-hidden="true"></div>
      </>
    )}

    <div class="main-col">
      <slot />
    </div>
  </main>
</Layout>

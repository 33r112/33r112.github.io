---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  /* space-separated modifier names, e.g. "half bw" — mapped onto the
     existing article-figure--<name> CSS classes. Note "half" means 50%
     of the *container*, which only reads as "half size" for images
     already larger than their container (like a real photo) — it does
     nothing useful for an image smaller than its container to begin
     with, e.g. a placeholder graphic. Use the width prop for those. */
  variant?: string;
  /* explicit CSS width (e.g. "160px"), for when the image's own
     intrinsic size — not the container — is what "smaller" should be
     relative to */
  width?: string;
}

const { src, alt, caption, variant, width } = Astro.props;

const variantClasses = (variant ?? "")
  .split(" ")
  .filter(Boolean)
  .map((name) => `article-figure--${name}`)
  .join(" ");
---

<figure class:list={["article-figure", variantClasses]}>
  {typeof src === "string" ? (
    <img src={src} alt={alt} style={width ? `width: ${width}` : undefined} />
  ) : (
    <Image src={src} alt={alt} style={width ? `width: ${width}` : undefined} />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

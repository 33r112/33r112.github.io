---
export interface Props {
  current: "home" | "library" | "projects" | "notes" | "about";
}

const { current } = Astro.props;

const links: { key: Props["current"]; href: string; label: string }[] = [
  { key: "home", href: "/", label: "Home" },
  { key: "library", href: "/library", label: "Reviews" },
  { key: "projects", href: "/projects", label: "Projects" },
  { key: "notes", href: "/notes", label: "Writing" },
  { key: "about", href: "/about", label: "About" },
];
---

<ul class="home-nav-vertical">
  {links.map((link) => (
    <li>
      <a
        class:list={["home-nav-vertical__link", { "is-active": link.key === current }]}
        href={link.href}
        aria-current={link.key === current ? "page" : undefined}
      >
        {link.label}
      </a>
    </li>
  ))}
</ul>

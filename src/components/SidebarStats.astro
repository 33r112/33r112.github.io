---
import StatsGroup from "./StatsGroup.astro";

export interface Props {
  label: string;
  items: { text: string; filter?: string }[];
  latest: string;
  filterTarget?: string;
  filterAttr?: string;
  // Notes/Writing moves its Posts/Thoughts/All group up next to the page
  // title instead — pass false there so this doesn't render it twice
  showCounts?: boolean;
}

const { label, items, latest, filterTarget, filterAttr, showCounts = true } = Astro.props;
---

<div class="sidebar-stats">
  {showCounts && <StatsGroup label={label} items={items} filterTarget={filterTarget} filterAttr={filterAttr} />}
  <StatsGroup label="LATEST" items={[{ text: latest }]} />
</div>

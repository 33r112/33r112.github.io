---
import StatsGroup from "./StatsGroup.astro";

export interface Props {
  latest: string;
}

// the per-category counts each page used to show above this (13 Reviews,
// 7 Projects, Posts/Thoughts) are gone — Writing and Library already
// carry theirs as the filter tabs next to the page title, and Projects
// didn't need a bare total. Only LATEST is left in the sidebar.
const { latest } = Astro.props;
---

<div class="sidebar-stats">
  <StatsGroup label="LATEST" items={[{ text: latest }]} />
</div>
